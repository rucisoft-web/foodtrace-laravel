# Cadangan untuk hosting yang document root-nya tidak bisa diarahkan ke folder public/.
# Disarankan: arahkan document root subdomain langsung ke folder public/ (lihat INSTALL-CPANEL.md).
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
<FilesMatch "^\.env|composer\.(json|lock)|artisan$">
    Require all denied
</FilesMatch>
